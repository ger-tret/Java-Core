<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="1" author="german.tretyakevich">
        <sql>CREATE TYPE payment_status AS ENUM ('FAILED','SUCCESS')</sql>
    </changeSet>
    <changeSet id="1-initial-payment-structure" author="german.tretyakevich">
        <createTable tableName="payments">
            <column name="payment_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="users_id"></constraints>
            </column>
            <column name="order_id" type="BIGINT">
                <constraints nullable="false"></constraints>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"></constraints>
            </column>
            <column name="payment_status" type="payment_status">
                <constraints nullable="false"></constraints>
            </column>
            <column name="timestamp" type="DATE">
                <constraints nullable="false"></constraints>
            </column>
            <column name="payment_amount" type="BIGINT">
                <constraints nullable="false"></constraints>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>